<!-- The migration source robot: a diff-drive rover with lidar and depth camera.
     This project. Deliberately imperfect in FOUR ways, each of which
     becomes a notes (see docs/CURRICULUM.md 1.4). The flaws are tagged
     FLAW-1..FLAW-4 so check_flaws.py can prove they are all still present:
     a "fixed" source robot would silently destroy other parts of this repo. -->
<robot name="rover">
  <material name="grey">
    <color rgba="0.35 0.37 0.40 1"/>
  </material>
  <material name="black">
    <color rgba="0.08 0.08 0.09 1"/>
  </material>
  <material name="amber">
    <color rgba="0.90 0.60 0.10 1"/>
  </material>
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.075"/>
  </joint>
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.4 0.28 0.1"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.28 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="6.0"/>
      <!-- FLAW-1: plausible-but-wrong inertia. These are the numbers a box of
           this size and mass would have IF it were a uniform solid, which this
           robot is not (battery low and rear, mast high and forward). Gazebo's
           solver is forgiving enough that the robot drives fine anyway; PhysX
           is not. a later check measures the difference and derives the real
           tensor on screen. Do NOT "fix" this here. -->
      <inertia ixx="0.0446" ixy="0" ixz="0" iyy="0.0850" iyz="0" izz="0.1192"/>
    </inertial>
  </link>
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin rpy="1.5707963 0 0"/>
      <inertia ixx="0.000769" ixy="0" ixz="0" iyy="0.000769" iyz="0" izz="0.001406"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <!-- z=0 puts the axle at base_link origin, which sits at wheel_r above
           the ground via base_joint. So the wheel bottom touches z=0 exactly. -->
    <origin xyz="0 0.15 0"/>
    <axis xyz="0 1 0"/>
    <!-- FLAW-2: a velocity limit Gazebo silently ignores for a continuous
           joint driven by gz_ros2_control, but which PhysX enforces on the
           articulation. 8 rad/s = 0.6 m/s at this radius, BELOW the 0.8 m/s
           the Nav2 config asks for. In Gazebo the robot hits 0.8; in Isaac it
           saturates and Nav2's tuning goes stale. a later check. -->
    <limit effort="12.0" velocity="8.0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <link name="right_wheel">
    <visual>
      <origin rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.075"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.0</mu>
            <mu2>1.0</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin rpy="1.5707963 0 0"/>
      <inertia ixx="0.000769" ixy="0" ixz="0" iyy="0.000769" iyz="0" izz="0.001406"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <!-- z=0 puts the axle at base_link origin, which sits at wheel_r above
           the ground via base_joint. So the wheel bottom touches z=0 exactly. -->
    <origin xyz="0 -0.15 0"/>
    <axis xyz="0 1 0"/>
    <!-- FLAW-2: a velocity limit Gazebo silently ignores for a continuous
           joint driven by gz_ros2_control, but which PhysX enforces on the
           articulation. 8 rad/s = 0.6 m/s at this radius, BELOW the 0.8 m/s
           the Nav2 config asks for. In Gazebo the robot hits 0.8; in Isaac it
           saturates and Nav2's tuning goes stale. a later check. -->
    <limit effort="12.0" velocity="8.0"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>
  <!-- Rear caster. A sphere, so it cannot fight the diff-drive kinematics the
       way a badly-modelled swivel wheel does. C3 S4 already taught why. -->
  <link name="caster">
    <visual>
      <geometry>
        <sphere radius="0.030"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.030"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>0.05</mu>
            <mu2>0.05</mu2>
          </ode>
        </friction>
      </surface>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="5.4e-5" ixy="0" ixz="0" iyy="5.4e-5" iyz="0" izz="5.4e-5"/>
    </inertial>
  </link>
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster"/>
    <origin xyz="-0.15 0 -0.045"/>
  </joint>
  <!-- Sensor mast -->
  <link name="mast">
    <visual>
      <geometry>
        <cylinder length="0.18" radius="0.02"/>
      </geometry>
      <material name="amber"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.18" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.30"/>
      <inertia ixx="8.5e-4" ixy="0" ixz="0" iyy="8.5e-4" iyz="0" izz="6.0e-5"/>
    </inertial>
  </link>
  <joint name="mast_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mast"/>
    <origin xyz="0.10 0 0.14"/>
  </joint>
  <link name="lidar_link">
    <!-- FLAW-5: the mesh path uses package://, which is a ROS convention.
         Gazebo resolves it because it was launched from a sourced workspace
         and inherits GZ_SIM_RESOURCE_PATH / the ament index. Isaac Sim, started
         as its own application, has neither. The importer must be TOLD where
         the package is (ros_package_paths) or the reference resolves to
         nothing, and an unresolved mesh is not an error: it is a link that
         silently has no visual. a later check.

         The mesh is a 16-sided prism, not a cylinder, deliberately: the
         collision below is still the analytic cylinder it replaced, so visual
         and collision now DISAGREE by construction. That divergence is the
         second half of 3.4, and the facet count is the setup for 3.7. -->
    <visual>
      <geometry>
        <mesh filename="package://rover_description/meshes/lidar_housing.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.04" radius="0.035"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.10"/>
      <inertia ixx="4.4e-5" ixy="0" ixz="0" iyy="4.4e-5" iyz="0" izz="6.1e-5"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="mast"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.11"/>
  </joint>
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.09 0.025"/>
      </geometry>
      <material name="black"/>
    </visual>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="5.9e-5" ixy="0" ixz="0" iyy="6.0e-6" iyz="0" izz="5.9e-5"/>
    </inertial>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="mast"/>
    <child link="camera_link"/>
    <origin xyz="0.03 0 0.04"/>
  </joint>
  <!-- The optical frame. REP-103: optical frames are z-forward, x-right,
       y-down, rotated from the ROS body convention. Isaac's camera prim uses
       a different convention again, and a later check measures what that does
       to a point cloud. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
  <!-- ================= ros2_control ================= -->
  <ros2_control name="GzSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-8.0</param>
        <param name="max"> 8.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-8.0</param>
        <param name="max"> 8.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>sim-workspace/install/rover_description/share/rover_description/config/controllers.yaml</parameters>
    </plugin>
    <!-- FLAW-3: a Gazebo-only plugin with no Isaac equivalent. The stack
         subscribes to /rover/battery and a node downstream gates motion on it.
         Nothing in Isaac publishes this, so after migration the robot appears
         to work and then stops. a later check replaces it with OmniGraph. -->
    <plugin filename="gz-sim-linearbatteryplugin-system" name="gz::sim::systems::LinearBatteryPlugin">
      <battery_name>rover_battery</battery_name>
      <voltage>12.6</voltage>
      <open_circuit_voltage_constant_coef>12.6</open_circuit_voltage_constant_coef>
      <capacity>7.0</capacity>
      <power_load>6.0</power_load>
    </plugin>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>640</samples>
            <min_angle>-2.356</min_angle>
            <max_angle>2.356</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>
  <gazebo reference="camera_link">
    <!-- FLAW-4: the depth camera publishes at 30 Hz while the physics step is
         1 ms (1000 Hz) and the lidar is 10 Hz. In Gazebo the perception stack
         tolerates it. This is the same class of rate/timestep misalignment that
         produced the measured 0.33x bug in an earlier measurement, and a later check
         reproduces it from the Gazebo side. -->
    <sensor name="depth_camera" type="depth_camera">
      <topic>depth</topic>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R_FLOAT32</format>
        </image>
        <clip>
          <near>0.10</near>
          <far>10.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
    </sensor>
  </gazebo>
  <gazebo reference="left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="caster">
    <mu1>0.05</mu1>
    <mu2>0.05</mu2>
  </gazebo>
</robot>
