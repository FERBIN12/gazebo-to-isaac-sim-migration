        def MjcActuator "left_wheel_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -0.009999999776482582, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:biasType = "affine"
            uniform double mjc:forceRange:max = 12
            uniform double mjc:forceRange:min = -12
            uniform double[] mjc:gainPrm = [0.009999999776482582, 0, 0, 0, 0, 0, 0, 0, 0, 0]
            uniform token mjc:gainType = "fixed"
            custom rel mjc:target
            prepend rel mjc:target = </rover/Physics/left_wheel_joint>
        }

        def MjcActuator "right_wheel_joint_actuator"
        {
            uniform double[] mjc:biasPrm = [0, 0, -0.009999999776482582, 0, 0, 0, 0, 0, 0, 0]
