#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "rover"
    doc = """Generated from Composed Stage of root layer /tmp/tmp4blixr3e/rover.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_rover_jfzx9xae/usdex_rover/rover.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_rover_jfzx9xae/temp_rover/rover.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "rover" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </rover/Physics/left_wheel_joint>,
        </rover/Physics/right_wheel_joint>,
        </rover/Physics/caster_joint>,
        </rover/Physics/mast_joint>,
        </rover/Physics/lidar_joint>,
        </rover/Physics/camera_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </rover/Geometry/base_footprint/base_link>,
        </rover/Geometry/base_footprint/base_link/left_wheel>,
        </rover/Geometry/base_footprint/base_link/right_wheel>,
        </rover/Geometry/base_footprint/base_link/caster>,
        </rover/Geometry/base_footprint/base_link/mast>,
        </rover/Geometry/base_footprint/base_link/mast/lidar_link>,
        </rover/Geometry/base_footprint/base_link/mast/camera_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_footprint"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_wheel" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "right_wheel" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "caster" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "mast" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "lidar_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                    }

                    over "camera_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "camera_optical_frame" (
                            prepend apiSchemas = ["IsaacSiteAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "left_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_wheel_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "caster_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "mast_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "lidar_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "camera_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

