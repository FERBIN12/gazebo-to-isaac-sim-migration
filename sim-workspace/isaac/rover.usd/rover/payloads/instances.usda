def Scope "Instances"
{
    def Xform "lidar_housing" (
        prepend references = @./geometries.usd@</Geometries/lidar_housing>
    )
    {
        over "lidar_housing" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/lidar_housing/VisualMaterials/black>
        }

        def Scope "VisualMaterials"
        {
            def Material "black" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/black>
            )
            {
            }
        }
    }
}

